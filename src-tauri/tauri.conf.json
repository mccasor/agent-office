{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Office",
  "version": "0.4.2",
  "identifier": "app.agent-office.menubar",
  "build": {
    "frontendDist": "splash",
    "beforeDevCommand": { "script": "npm run build && node scripts/prepare-tauri.mjs", "cwd": ".." },
    "beforeBuildCommand": { "script": "npm run build && node scripts/prepare-tauri.mjs", "cwd": ".." }
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "resources": { "resources/app/": "app/" },
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-" }
  }
}
