{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Office",
  "version": "../package.json",
  "identifier": "app.agent-office.menubar",
  "build": {
    "frontendDist": "splash",
    "beforeDevCommand": {
      "script": "npm run build && node scripts/prepare-tauri.mjs",
      "cwd": ".."
    },
    "beforeBuildCommand": {
      "script": "npm run build && node scripts/prepare-tauri.mjs",
      "cwd": ".."
    }
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:4318; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    },
    "macOSPrivateApi": true,
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "resources/app/": "app/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
