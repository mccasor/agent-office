{
  "name": "agent-office",
  "version": "0.7.5",
  "description": "Pixel-art 2D office that shows your Claude Code agents at work in real time, in the browser or from the macOS menu bar",
  "type": "module",
  "license": "MIT",
  "bin": {
    "agent-office": "bin/agent-office.mjs",
    "agent-office-hook": "bin/agent-office-hook.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/cli.ts --no-open --port 4317\" \"vite\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node bin/agent-office.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "settings:catalog": "tsx scripts/settings-catalog.ts",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "app:release": "node scripts/release.mjs"
  },
  "dependencies": {
    "chokidar": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
